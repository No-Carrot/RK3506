BR2_PACKAGE_LVGL_DEMO=y
BR2_LVGL_DEMO_MOTOR_DEMO=y
# The motor demo only needs LVGL DRM/evdev plus EtherCAT. Keep the RKADK/Rockit
# multimedia path out of this image so VENC/AVS/IPC probes are not started.
BR2_LVGL_DEMO_BACKEND_DRM=y
# BR2_LVGL_DEMO_BACKEND_RKADK is not set
# BR2_LV_DRIVERS_USE_RKADK is not set
# BR2_PACKAGE_RKADK is not set
# BR2_PACKAGE_RKADK_DISPLAY is not set
# BR2_PACKAGE_RKADK_PLAYER is not set
# BR2_PACKAGE_RKADK_EXAMPLES is not set
# BR2_PACKAGE_ROCKIT is not set

# Production UI profile: keep the widgets used by servo_ui.c only.
# Chinese text and the dial needle are runtime assets; keep FreeType, the
# SmileySans TTF, LVGL image support, PNG decoding, and stdio FS access.
# BR2_LV_FONT_MONTSERRAT_12 is not set
BR2_LV_FONT_MONTSERRAT_14=y
# BR2_LV_FONT_MONTSERRAT_16 is not set
BR2_LV_FONT_MONTSERRAT_18=y
# BR2_LV_FONT_MONTSERRAT_20 is not set
BR2_LV_FONT_MONTSERRAT_22=y
BR2_LV_FONT_MONTSERRAT_24=y
BR2_LV_FONT_MONTSERRAT_32=y
# BR2_LV_FONT_SIMSUN_16_CJK is not set
BR2_LV_FONT_DEFAULT_MONTSERRAT_22=y
# BR2_LV_FONT_DEFAULT_SIMSUN_16_CJK is not set
BR2_LV_USE_FREETYPE=y
BR2_PACKAGE_FREETYPE=y

# Keep: ARC, BTN, IMG, LABEL, LINE, default theme. Drop the unused LVGL widget
# surface while preserving runtime font/image assets.
# BR2_LV_USE_LOG is not set
# BR2_LV_USE_ASSERT_NULL is not set
# BR2_LV_USE_ASSERT_MALLOC is not set
# BR2_LV_LABEL_TEXT_SELECTION is not set
# BR2_LV_LABEL_LONG_TXT_HINT is not set
# BR2_LV_USE_BAR is not set
# BR2_LV_USE_BTNMATRIX is not set
# BR2_LV_USE_CANVAS is not set
# BR2_LV_USE_CHECKBOX is not set
# BR2_LV_USE_DROPDOWN is not set
BR2_LV_USE_IMG=y
# BR2_LV_USE_ROLLER is not set
# BR2_LV_USE_SLIDER is not set
# BR2_LV_USE_SWITCH is not set
# BR2_LV_USE_TEXTAREA is not set
# BR2_LV_USE_TABLE is not set
# BR2_LV_USE_ANIMIMG is not set
# BR2_LV_USE_CALENDAR is not set
# BR2_LV_USE_CHART is not set
# BR2_LV_USE_COLORWHEEL is not set
# BR2_LV_USE_IMGBTN is not set
# BR2_LV_USE_KEYBOARD is not set
# BR2_LV_USE_LED is not set
# BR2_LV_USE_LIST is not set
# BR2_LV_USE_MENU is not set
# BR2_LV_USE_METER is not set
# BR2_LV_USE_MSGBOX is not set
# BR2_LV_USE_SPAN is not set
# BR2_LV_USE_SPINBOX is not set
# BR2_LV_USE_SPINNER is not set
# BR2_LV_USE_TABVIEW is not set
# BR2_LV_USE_TILEVIEW is not set
# BR2_LV_USE_WIN is not set
# BR2_LV_USE_FLEX is not set
# BR2_LV_USE_GRID is not set
BR2_LV_USE_FS_STDIO=y
BR2_LV_USE_PNG=y
# BR2_LV_USE_BMP is not set
# BR2_LV_USE_SJPG is not set
# BR2_LV_USE_GIF is not set
# BR2_LV_USE_SNAPSHOT is not set
BR2_PACKAGE_LIBPNG=y
