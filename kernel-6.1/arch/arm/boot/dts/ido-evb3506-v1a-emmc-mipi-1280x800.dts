                                hsync-active = <0>;
                                vsync-active = <0>;
                                de-active = <0>;
                                pixelclk-active = <1>;
                        };

		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};

};

&dsi_dphy {
    status = "okay";
};

&dsi_in_vop {
	status = "okay";
};

&dsi_panel {
	power-supply = <&vcc3v3_lcd_n>;
};

&route_dsi{
        status = "okay";
		connect = <&vop_out_dsi>;
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io0_i2c0_scl
		     &rm_io1_i2c0_sda>;

	gt911@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		pinctrl-0 = <&touch_gpio>;
		touch-gpio = <&gpio0 RK_PA2 IRQ_TYPE_LEVEL_LOW>;
		reset-gpio = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
		max-x = <800>;
		max-y = <1280>;
		tp-size = <9110>;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
//		touchscreen-swapped-x-y;
		status = "okay";
	};
};

&vop {
	status = "okay";
};

&pinctrl {
	touch {
		touch_gpio: touch-gpio {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		reset_gpio: reset-gpio {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
