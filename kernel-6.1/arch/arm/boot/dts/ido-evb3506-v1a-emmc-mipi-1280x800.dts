		disp_timings0: display-timings {
			native-mode = <&dsi_timing2>;
			dsi_timing0: timing0 {
				clock-frequency = <48000000>;
				hactive = <720>;
				vactive = <720>;
				hfront-porch = <106>;
				hsync-len = <8>;
				hback-porch = <120>;
				vfront-porch = <20>;
				vsync-len = <4>;
				vback-porch = <20>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
			dsi_timing1: timing1 {
				clock-frequency = <52000000>;
				hactive = <1024>;
				vactive = <600>;
				hfront-porch = <5>;
				hsync-len = <10>;
				hback-porch = <60>;
